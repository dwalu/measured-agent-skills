#!/bin/sh
# pre-commit hook. Enable once per clone:  git config core.hooksPath .githooks
#
# Tracking consistency is gate #1 deliberately: it is pure Node with no
# dependencies, so it runs in milliseconds and works before `npm install` ever
# has — which matters, because the first commit in a repo is the one that adds
# the toolchain.
#
# Add your own lint/typecheck/test gates below this block.
set -e

node scripts/validate-tracking.mjs || {
  echo "" >&2
  echo "Commit blocked: tracking validation failed (see above)." >&2
  echo "  Fix {{DIR}}/**, run 'node scripts/validate-tracking.mjs --write', then retry." >&2
  exit 1
}
